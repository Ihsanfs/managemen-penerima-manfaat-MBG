# ============================================================
# Supabase Cloud — koneksi PostgreSQL langsung untuk Laravel.
# Salin blok DB_* di bawah ke dalam .env.
#
# Project : mxuxyvqkowabydsscgth
# URL     : https://mxuxyvqkowabydsscgth.supabase.co
#
# Password database bisa dilihat/direset di:
#   Supabase Dashboard -> Settings -> Database -> Database password -> Reset
# Jangan commit .env yang berisi password asli.
# ============================================================

DB_CONNECTION=pgsql
DB_HOST=db.mxuxyvqkowabydsscgth.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=ISI_DATABASE_PASSWORD_SUPABASE
DB_SSLMODE=require

# Alternatif: Connection Pooler (transaction mode) untuk traffic aplikasi.
# Gunakan DB_PORT=6543 bila koneksi langsung sering putus / banyak request bersamaan.
# Catatan: untuk menjalankan migration sebaiknya tetap pakai port 5432.
# DB_PORT=6543

# Kunci publik Supabase (bukan untuk koneksi DB Eloquent).
# Dipakai hanya jika nanti integrasi Auth/Storage/Realtime via Supabase SDK.
SUPABASE_URL=https://mxuxyvqkowabydsscgth.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_56VMqvEpnbo5lJu5YnPrLw_PU8jhcLB
