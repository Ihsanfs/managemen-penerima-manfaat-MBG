# Contoh konfigurasi PostgreSQL.
# Salin nilai di bawah ini ke dalam .env saat ingin beralih dari SQLite/MySQL.
# Jangan commit file .env yang berisi password asli.

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sppg_samarang
DB_USERNAME=sppg
DB_PASSWORD=sppg_secret
DB_SSLMODE=prefer
